<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputPath>..\lib</OutputPath>
    <UseWindowsForms>true</UseWindowsForms>
    
    <VLPackageBasePath>..\</VLPackageBasePath>
    <Description>Windows specific VL CoreLib</Description>

    <!-- We reference packages with .net framework assemblies. Ignore because we're the Windows only package. -->
    <NoWarn>$(NoWarn)NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\VL.CoreLib\src\VL.CoreLib.csproj" />
    <ProjectReference Include="..\..\VL.Core\src\VL.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="AudioSwitcher.AudioApi.CoreAudio" />
    <PackageReference Include="AudioSwitcher.AudioApi" />
    <PackageReference Include="Ookii.Dialogs.WinForms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Win32 for the window of the window contract (Windowing/): title bar, pointer input -->
    <None Remove="NativeMethods.txt" />
    <AdditionalFiles Include="NativeMethods.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- The icon of the window of the window contract (WinFormsAppWindow) -->
    <EmbeddedResource Include="Windowing\vvvv.ico" LogicalName="VL.Core.Windows.vvvv.ico" />
  </ItemGroup>

</Project>
