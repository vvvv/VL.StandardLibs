<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!-- Import VL custom Stride asset compiler targets -->
  <Import Project="$(MSBuildThisFileDirectory)build\VL.Stride.AssetCompiler.targets" />

  <!-- Projects which don't target Windows must build and run on macOS and Linux: an unguarded call of a Windows only API is an error. -->
  <!-- Lives in the targets file because the target framework isn't known yet when the props file gets evaluated. -->
  <PropertyGroup Condition="'$(TargetFramework)' != '' AND !$(TargetFramework.EndsWith('-windows'))">
    <WarningsAsErrors>$(WarningsAsErrors);CA1416</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup Condition="$(VLPackageBasePath) != ''">
    <Content Include="$(VLPackageBasePath)*.vl" PackagePath="%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="$(VLPackageBasePath)Assets\**" PackagePath="Assets\%(RecursiveDir)%(Filename)%(Extension)" LinkBase="Assets" />
    <Content Include="$(VLPackageBasePath)help\**" PackagePath="help\%(RecursiveDir)%(Filename)%(Extension)" LinkBase="help" />
    <Content Include="$(VLPackageBasePath)vvvv\**" PackagePath="vvvv\%(RecursiveDir)%(Filename)%(Extension)" LinkBase="vvvv" />
    <Content Remove="$(VLPackageBasePath)**\*.vl.dll" />
  </ItemGroup>
  
  <!-- Fill out the blanks for VL packages  -->
  <PropertyGroup Condition="$(VLPackageBasePath) != ''">
    <PackageTags Condition="'$(PackageTags)' == ''">VL</PackageTags>
    <PackageProjectUrl Condition="'$(PackageProjectUrl)' == ''">http://vvvv.org</PackageProjectUrl>
    <PackageLicenseExpression Condition="'$(PackageLicenseExpression)' == ''">LGPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Puts the compiler generated nuspec file into the package root folder. This file will be read by our package system. -->
  <Target Name="_EnsureNuspecIsPresent" Condition="$(IsPackable) == 'true'" AfterTargets="GenerateNuspec">
    <PropertyGroup>
      <_GeneratedNuspecFile>$(BaseIntermediateOutputPath)$(Configuration)\$(PackageId).$(PackageVersion).nuspec</_GeneratedNuspecFile>
      <_ProjectDirName>$([System.IO.Path]::GetFileName('$(MSBuildProjectDirectory)'))</_ProjectDirName>
      <!-- If project dir name matches PackageId, put nuspec there. Otherwise (e.g., src/ subfolder), put it one level up -->
      <_NuspecDestinationPath Condition="'$(_ProjectDirName)' == '$(PackageId)'">$(MSBuildProjectDirectory)\$(PackageId).gen.nuspec</_NuspecDestinationPath>
      <_NuspecDestinationPath Condition="'$(_NuspecDestinationPath)' == ''">$(MSBuildProjectDirectory)\..\$(PackageId).gen.nuspec</_NuspecDestinationPath>
    </PropertyGroup>
    <Copy Condition="Exists('$(_GeneratedNuspecFile)')" SourceFiles="$(_GeneratedNuspecFile)" DestinationFiles="$(_NuspecDestinationPath)" SkipUnchangedFiles="true" />
  </Target>

  <!--
    A package from source is read from its folder: the restore of a document takes the assemblies of lib/<framework> nearest to its target, whatever the nuspec lists.
    So the output of this project for a framework it no longer builds (a flavor that went: lib/net10.0-windows of VL.Skia, VL.HDE) would win over the one it builds,
    even without its assembly (the copies of its references are still there, and the restore takes the folder). After each build a framework folder of a framework
    this project does not build goes whole: it is build output, and the lib folder of a package belongs to its one project.
  -->
  <Target Name="_RemoveOutputOfFrameworksNotBuilt" AfterTargets="Build" Condition="'$(VLPackageBasePath)' != '' AND '$(TargetFramework)' != '' AND Exists('$(OutDir)..')">
    <PropertyGroup>
      <_BuiltFrameworks>;$(TargetFrameworks);$(TargetFramework);</_BuiltFrameworks>
    </PropertyGroup>
    <ItemGroup>
      <_FrameworkFolder Include="$([System.IO.Directory]::GetDirectories('$([System.IO.Path]::GetFullPath('$(OutDir)..'))'))" />
      <_NotBuiltFrameworkFolder Include="@(_FrameworkFolder)" Condition="$([System.String]::Copy('%(Filename)%(Extension)').StartsWith('net')) AND !$(_BuiltFrameworks.Contains(';%(Filename)%(Extension);'))" />
    </ItemGroup>
    <Message Importance="high" Condition="'@(_NotBuiltFrameworkFolder)' != ''" Text="$(AssemblyName): removing the output of frameworks it does not build: @(_NotBuiltFrameworkFolder->'%(FullPath)', ', ')" />
    <RemoveDir Directories="@(_NotBuiltFrameworkFolder)" />
  </Target>

  <ItemGroup Condition=" '$(IsPackable)' != 'false' ">
    <None Include="$(MsBuildThisFileDirectory)build\nugeticon.png" Pack="true" PackagePath="\"/>
  </ItemGroup>

  <!-- Workaround to specifiy aliases for PackageReference - taken from https://github.com/NuGet/Home/issues/4989 -->
  <Target Name="AddPackageAliases" BeforeTargets="ResolveReferences" Outputs="%(PackageReference.Identity)">
    <PropertyGroup>
      <AliasPackageReference>@(PackageReference->'%(Identity)')</AliasPackageReference>
      <AliasName>@(PackageReference->'%(Alias)')</AliasName>
    </PropertyGroup>

    <ItemGroup>
      <ReferencePath Condition="'%(FileName)'=='$(AliasPackageReference)'">
        <Aliases>$(AliasName)</Aliases>
      </ReferencePath>
    </ItemGroup>
  </Target>

  <!-- Remove Stride content files from non-entry points -->
  <Target Name="_RemoveStrideDependencyContentFiles" AfterTargets="_StrideCopyContent">
    <ItemGroup>
      <Content Remove="@(_StrideDependencyContent)" Condition=" '$(StrideIsExecutable)' == '' or '$(StrideIsExecutable)' == 'false' " />
    </ItemGroup>
  </Target>

  <!-- Remove glslLangValidator.exe (stemming from Stride.Shaders.Compiler) from our packages -->
  <Target Name="_RemoveGlslLangValidatorFromPackage" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <Content Condition="'%(Content.Filename)' == 'glslangValidator'">
        <Pack>false</Pack>
      </Content>
    </ItemGroup>
  </Target>

  <!-- Causes build error on ARM64 -->
  <Target Name="_StrideCheckVisualCRuntime2019">
    
  </Target>
  
</Project>