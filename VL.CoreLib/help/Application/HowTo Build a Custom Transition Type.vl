            <Pin Id="O9CdHbyQZN8M9KMOYo9gZp" Name="Max Velocity" Kind="InputPin" DefaultValue="999" />
            <Pin Id="J5qjvzGXQGJLQInxgRejpP" Name="Cyclic" Kind="InputPin" DefaultValue="False" />
            <Pin Id="LY4nAHAp8c2LpVtl40RD21" Name="Constant Drive" Kind="InputPin" DefaultValue="0.6" />
