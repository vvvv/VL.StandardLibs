      <Patch Id="BGZ5gz9iYAGLUu9C3VAlzk">
        <Canvas Id="KzSsgD9Ax2DLX421W3MarP" CanvasType="Group">
          <Pad Id="HuLHBcIcGiNNfGlle3TWUP" Bounds="100,30,638,159" ShowValueBox="true" isIOBox="true" Value="A transition decides how a public channel moves from its current value to a new one. Transitions work with the following nodes:&#xD;&#xA;&#xD;&#xA;- TriggerPreset: moves channels to the values stored in a preset&#xD;&#xA;- GoToValue moves one channel to a value you give it. &#xD;&#xA;&#xD;&#xA;Both take the transition on their Transition (Model) input. Without one, the default transitions apply: floats, vectors and colors glide, everything else jumps.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="G4ygomsHmHzLDZ2ufoV6Ic" Bounds="99,260,374,136" ShowValueBox="true" isIOBox="true" Value="A smooth curve that takes the current velocity of the channel into account.&#xD;&#xA;- Turning Point (0..1): when to get going into the right direction&#xD;&#xA;- Dynamics: 0 = linear, 0.3333 = default, 1 = nuts&#xD;&#xA;- Max Warmup Duration (in seconds): tries to avoid going into the wrong direction for too long">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="RPaVyQrOKw4M077fcqEDKr" Bounds="499,260,346,82" ShowValueBox="true" isIOBox="true" Value="Classic easing functions.&#xD;&#xA;- Transition: the easing function (Linear, Quad, Cubic, Elastic, Bounce, ...)&#xD;&#xA;- Mode: where the easing is applied (In, Out, InOut)">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="Q6nndc2aQ2rM8tUNHZYvQC" Bounds="982,716,265,67" ShowValueBox="true" isIOBox="true" Value="The same transition, applied to the Tween channel with a value instead of a preset.">
