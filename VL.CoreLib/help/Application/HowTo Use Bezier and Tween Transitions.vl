      <Patch Id="BGZ5gz9iYAGLUu9C3VAlzk">
        <Canvas Id="KzSsgD9Ax2DLX421W3MarP" CanvasType="Group">
          <Pad Id="HuLHBcIcGiNNfGlle3TWUP" Bounds="100,30,560,119" ShowValueBox="true" isIOBox="true" Value="A transition decides how a public channel moves from its current value to the value stored in a preset.&#xD;&#xA;&#xD;&#xA;TriggerPreset takes one on its Transition input. Without one, the default transitions apply: floats, vectors and colors glide, everything else jumps.&#xD;&#xA;&#xD;&#xA;Two channels, Bezier and Tween, are moved by the same duration with different transitions. Click the Apply buttons and watch the values.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="G4ygomsHmHzLDZ2ufoV6Ic" Bounds="100,180,300,136" ShowValueBox="true" isIOBox="true" Value="BezierTransition: a smooth curve that takes the current velocity of the channel into account.&#xD;&#xA;- Turning Point (0..1): when to get going into the right direction&#xD;&#xA;- Dynamics: 0 = linear, 0.3333 = default, 1 = nuts&#xD;&#xA;- Max Warmup Duration (in seconds): tries to avoid going into the wrong direction for too long">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="RPaVyQrOKw4M077fcqEDKr" Bounds="500,180,300,85" ShowValueBox="true" isIOBox="true" Value="TweenTransition: classic easing functions.&#xD;&#xA;- Transition: the easing function (Linear, Quad, Cubic, Elastic, Bounce, ...)&#xD;&#xA;- Mode: where the easing is applied (In, Out, InOut)">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Node Bounds="160,340,90,19" Id="D2aTlprHHARM2h6iWQeeOL">
