            <Pin Id="HQQHuKfBaAwLsaYnDegqDW" Name="Turning Point" Kind="InputPin" DefaultValue="0.5" />
            <Pin Id="VSFqhR865aNNfPkUk1Yvfn" Name="Dynamics" Kind="InputPin" DefaultValue="0.33333334" />
            <Pin Id="CpKGRZ6dYtoNa13Q9aNyNo" Name="Max Warmup Duration" Kind="InputPin" DefaultValue="3" />
            <Pin Id="LOp2h7SacwIQGU1v5jmqmD" Name="Output" Kind="OutputPin" />
