          <Pad Id="JzPHEQPGjGIOWRuvPNYLTi" Bounds="60,20,560,119" ShowValueBox="true" isIOBox="true" Value="Presets live in a folder called presets next to the .vl document, unless you say otherwise.&#xD;&#xA;&#xD;&#xA;This patch says otherwise: the class MyStartup sets the configuration item `Presets:Folder` to a folder called MyPresets next to this document. The preset system reads that item when it starts up, so it has to be set in a startup class: changing it later has no effect.&#xD;&#xA;&#xD;&#xA;Presets in that folder: Loud and Quiet. Click Apply to recall one.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
