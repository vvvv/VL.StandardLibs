            <Pad Id="Ve01j3NwN7TQHyU3CzQFg6" Bounds="453,220,500,295" ShowValueBox="true" isIOBox="true" Value="&lt; Open the Inspektor (Ctrl+F1) and select a pad to set metadata:&#xD;&#xA;&#xD;&#xA;- Default&#xD;&#xA;- Min&#xD;&#xA;- Max&#xD;&#xA;- Order&#xD;&#xA;- Widget&#xD;&#xA;- Read-Only&#xD;&#xA;- Label&#xD;&#xA;- Description&#xD;&#xA;- Tags&#xD;&#xA;- Custom Metadata&#xD;&#xA;&#xD;&#xA;In addition you can define:&#xD;&#xA;- Public: Whether or not to have this property as Public Channel, when published&#xD;&#xA;- Publish Individual Items: Whether or not to publish entries of a spread as individual Public Channels">
              <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
                <Choice Kind="TypeFlag" Name="String" />
              </p:TypeAnnotation>
              <p:ValueBoxSettings>
                <p:fontsize p:Type="Int32">9</p:fontsize>
