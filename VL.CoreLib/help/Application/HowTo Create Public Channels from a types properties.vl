          </Pad>
          <Pad Id="KU7juEvc0ckNGcnpNzQF7P" Bounds="54,100,262,321" ShowValueBox="true" isIOBox="true" Value="The Publish node creates Public Channels out of all properties of a type. &#xD;&#xA;&#xD;&#xA;It does that and writes the channels to the .pc file:&#xD;&#xA;- Once on every start of an app&#xD;&#xA;- At runtime when a property is added &#xD;&#xA;&#xD;&#xA;Removing a property from a type will not automatically remove a once published Public Channel.&#xD;&#xA;&#xD;&#xA;To clean up stray Public Channels, in the Channel Browser:&#xD;&#xA;- Rightclick a channel and click &quot;Remove&quot;&#xD;&#xA;- In the topright corners ... menu click &quot;Remove unused Channels&quot;.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
