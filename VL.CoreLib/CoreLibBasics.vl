                <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
                  <Choice Kind="TypeFlag" Name="Boolean" />
                  <CategoryReference Kind="Category" Name="Primitive" />
                </p:TypeAnnotation>
              </Pad>
              <Pad Id="HG5oWr26QWLM7bUF50IRMf" SlotId="OYaYS4SHJkELf7x3WIOAEi" Bounds="-36,693" />
              <Pad Id="NNPllBhBLSXOnjZEr3GTAl" SlotId="OYaYS4SHJkELf7x3WIOAEi" Bounds="-32,784" />
