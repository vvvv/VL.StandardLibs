          <Pad Id="CsHtFdGFiOCO6FLk3Xy4qf" Bounds="256,702,724,195" ShowValueBox="true" isIOBox="true" Value="This Demo&#xD;&#xA;&#xD;&#xA;- Go to Edit Mode in Stride Window (F4) and zoom out until you see the lights.&#xD;&#xA;- Open the Channel Browser (Ctrl+F4) and resize it so that two preset columns are visible&#xD;&#xA;- Press Play buttons and see the lights moving &#xD;&#xA;- Use Gizmos to change postions. See the values change in the Browser.&#xD;&#xA;- Shift-Scroll zooms the Gizmos">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">12</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Overlay Id="UCHmf0wwGWdNdg6XwNA2u9" Name="" Bounds="251,681,767,239">
            <p:ColorIndex p:Type="Int32">3</p:ColorIndex>
          </Overlay>
          <Pad Id="BksFe1bKdAMMJDpAJorvHV" Bounds="276,969,554,456" ShowValueBox="true" isIOBox="true" Value="Locations:&#xD;&#xA;Locations are designed so that they can be used with and without the public channel system. They have channel inputs, which they write back into when you edit them in Edit Mode. This is similar to how ImGui widgets have channel inputs.&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;SubChannels:&#xD;&#xA;When you use them in a public channel setup you have to feed your own channel to the Location and the property on create. The public SubChannels that get created per property will then get glued to the Channels you provided.&#xD;&#xA;For that to work you need to provide the channels on create. &#xD;&#xA;&#xD;&#xA;&#xD;&#xA;You are the boss about the structure of your public channel structure:&#xD;&#xA;&#xD;&#xA;This demo shows how you can group the properties as you want. &#xD;&#xA;- The boxes expose position, rotation and scaling.&#xD;&#xA;- Spots expose positions, they don't expose rotaton and scaling. They also expose other properties. For that I made my own Spot datatype.&#xD;&#xA;- The Target for both Spots is exposed as only one position. I wanted to think of them as one thing.&#xD;&#xA;&#xD;&#xA;These are only examples showing that you are free in the way to reason about the structure of properties and channels.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Node Bounds="369,520,49,19" Id="FmQ39d5BEKqMvd5ecRGMeW">
            <p:NodeReference LastCategoryFullName="Reactive.ChannelHub.Modules.SubChannels" LastDependency="VL.CoreLib.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <CategoryReference Kind="Category" Name="SubChannels" NeedsToBeDirectParent="true" />
              <Choice Kind="ProcessAppFlag" Name="Publish" />
            </p:NodeReference>
            <Pin Id="HqxeTYCdMQ7NzforuyKvQU" Name="Node Context" Kind="InputPin" IsHidden="true" />
            <Pin Id="RQ42JPpo4wTMLvI6cJ0cXx" Name="Value" Kind="InputPin" />
            <Pin Id="Ho85D2OiEciO6Siqj61QDU" Name="Output" Kind="OutputPin" />
            <Pin Id="MpeIuEMVI57LIokeC05Uj7" Name="SubChannels" Kind="OutputPin" />
            <Pin Id="K7tO1qNwTj1PS8mHO6eZVv" Name="Path" Kind="InputPin" DefaultValue="SceneA" />
          </Node>
          <Node Bounds="369,180,125,19" Id="HURc2gKGM6ZPv1fIiZJnUj">
