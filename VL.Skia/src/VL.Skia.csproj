<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputPath>..\lib</OutputPath>
    
    <!-- We pack native dll in our own NuGet package -->
    <ShouldIncludeNativeSkiaSharp>False</ShouldIncludeNativeSkiaSharp>
    
    <VLPackageBasePath>..\</VLPackageBasePath>
    <Description>A 2d graphics rendering library for vvvv based on Skia</Description>
    <PackageTags>VL, 2d, renderer, gpu, image, gif, svg, pdf, text, touch, imageplayer, video, lottie, skottie</PackageTags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Direct3D11 of the video nodes (they run on Windows only) -->
    <PackageReference Include="SharpDX.Direct3D11" />
    <PackageReference Include="SkiaSharp.Skottie" ExcludeAssets="build;buildTransitive" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\VL.Core.Commands\src\VL.Core.Commands.csproj" />
    <ProjectReference Include="..\..\VL.Core.Skia\VL.Core.Skia.csproj" />
    <ProjectReference Include="..\..\VL.CoreLib\src\VL.CoreLib.csproj" />
    <ProjectReference Include="..\..\VL.Core\src\VL.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <!--
    The document VL.Skia.vl is written in the editor on Windows: its node "RenderWindow (Upcoming Experimental)" is made of Windows Forms nodes, and it depends on the packages
    VL.CoreLib.Windows and VL.Core.Skia.Windows and on System.Windows.Forms. Where those do not exist (Linux, macOS) the document can't be compiled.
    The package therefore carries a copy of the document without these parts too (folder portable, build/PortableVlDocument.targets). Everything else is the same document:
    the Renderer node, which is built on the SkiaRendererNode of the flavor of the assembly, is in it. (The long term solution is to move the Windows part into a document of
    the Windows packages.)
  -->
  <PropertyGroup>
    <PortableVlDocument>VL.Skia.vl</PortableVlDocument>
    <PortableVlDocumentRemoveDependencies>VL.CoreLib.Windows;VL.Core.Skia.Windows;System.Windows.Forms;./lib/net10.0-windows/VL.CoreLib.dll</PortableVlDocumentRemoveDependencies>
    <PortableVlDocumentRemoveNodes>RenderWindow (Upcoming Experimental);VideoSourceToSKImage</PortableVlDocumentRemoveNodes>
  </PropertyGroup>
</Project>