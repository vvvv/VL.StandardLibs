<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <!-- The Windows flavor (WinForms renderer) can only be built on Windows -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0;net10.0-windows</TargetFrameworks>
    <OutputPath>..\lib</OutputPath>
    
    <!-- We pack native dll in our own NuGet package -->
    <ShouldIncludeNativeSkiaSharp>False</ShouldIncludeNativeSkiaSharp>
    
    <VLPackageBasePath>..\</VLPackageBasePath>
    <Description>A 2d graphics rendering library for vvvv based on Skia</Description>
    <PackageTags>VL, 2d, renderer, gpu, image, gif, svg, pdf, text, touch, imageplayer, video, lottie, skottie</PackageTags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SharpDX.Direct3D11" />
    <PackageReference Include="SkiaSharp.Skottie" ExcludeAssets="build;buildTransitive" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\VL.Core.Commands\src\VL.Core.Commands.csproj" />
    <ProjectReference Include="..\..\VL.Core.Skia.Windows\VL.Core.Skia.Windows.csproj" Aliases="sw" Condition="'$(TargetFramework)' == 'net10.0-windows'" />
    <ProjectReference Include="..\..\VL.Core.Skia\VL.Core.Skia.csproj" />
    <ProjectReference Include="..\..\VL.CoreLib.Windows\src\VL.CoreLib.Windows.csproj" Condition="'$(TargetFramework)' == 'net10.0-windows'" />
    <ProjectReference Include="..\..\VL.CoreLib\src\VL.CoreLib.csproj" />
    <ProjectReference Include="..\..\VL.Core\src\VL.Core.csproj" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Suppress warning about conditional compilation in SkiaRenderer.cs - the entire file is Windows-specific -->
    <NoWarn>$(NoWarn);MSB3042</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="SkiaRenderer.cs" />
    <Compile Update="SkiaRenderer.Designer.cs">
      <DependentUpon>SkiaRenderer.cs</DependentUpon>
    </Compile>
    <Compile Update="Control.cs">
      <SubType>UserControl</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="SkiaRenderer.resx">
      <DependentUpon>SkiaRenderer.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Exclude Windows-specific embedded resources from non-Windows builds -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-windows' AND '$(TargetFramework)' != ''">
    <Compile Remove="Properties\Resources.Designer.cs" />
    <EmbeddedResource Remove="Properties\Resources.resx" />
    <EmbeddedResource Remove="SkiaRenderer.resx" />
  </ItemGroup>
  <!--
    The document VL.Skia.vl is written in the editor on Windows: its node "RenderWindow (Upcoming Experimental)" is made of Windows Forms nodes, and it depends on the packages
    VL.CoreLib.Windows and VL.Core.Skia.Windows and on System.Windows.Forms. Where those do not exist (Linux, macOS) the document can't be compiled.
    The package made on a system other than Windows therefore gets a copy of the document without these parts. Everything else is the same document: the Renderer node, which is built on
    the SkiaRendererNode of the flavor of the assembly, is in it. (The long term solution is to move the Windows part into a document of the Windows packages.)
  -->
  <UsingTask TaskName="StripWindowsFromVlDocument" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Input ParameterType="System.String" Required="true" />
      <Output ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Xml.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var doc = XDocument.Load(Input, LoadOptions.PreserveWhitespace);
        var windowsOnly = new System.Collections.Generic.HashSet<string> { "VL.CoreLib.Windows", "VL.Core.Skia.Windows", "System.Windows.Forms", "./lib/net10.0-windows/VL.CoreLib.dll" };
        foreach (var d in doc.Root.Elements().Where(e => (e.Name.LocalName == "NugetDependency" || e.Name.LocalName == "PlatformDependency") && windowsOnly.Contains((string)e.Attribute("Location") ?? "")).ToList())
            d.Remove();
        foreach (var n in doc.Root.Descendants("Node").Where(e => (string)e.Attribute("Name") == "RenderWindow (Upcoming Experimental)").ToList())
            n.Remove();
        System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(Output));
        doc.Save(Output);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="UsePortableVlDocument" BeforeTargets="_GetPackageFiles" Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <StripWindowsFromVlDocument Input="$(MSBuildProjectDirectory)\..\VL.Skia.vl" Output="$(MSBuildProjectDirectory)\$(IntermediateOutputPath)portable\VL.Skia.vl" />
    <ItemGroup>
      <Content Remove="$(VLPackageBasePath)VL.Skia.vl" />
      <Content Include="$(MSBuildProjectDirectory)\$(IntermediateOutputPath)portable\VL.Skia.vl" PackagePath="VL.Skia.vl" Pack="true" />
    </ItemGroup>
  </Target>
</Project>
