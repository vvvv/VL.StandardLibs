<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputPath>..\lib</OutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>The VL core library.</Description>
    <PackageId>VL.Core</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.HighPerformance" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="NuGet.Versioning" />
    <!-- Only for the Windows only bitmap interop (BitmapImage, FromImage). Not handed on to projects referencing us: GDI+ is not available on macOS and Linux. -->
    <PackageReference Include="System.Drawing.Common" PrivateAssets="compile" />
    <PackageReference Include="System.Interactive" />
    <!-- Only for HardwareChangedEvents (Windows only) -->
    <PackageReference Include="System.Management" PrivateAssets="compile" />
    <PackageReference Include="System.Reactive" />
    <PackageReference Include="Stride.Core.Mathematics">
      <!-- We don't want all those Stride targets to flow up to all our projects -->
      <PrivateAssets>buildTransitive</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
</Project>