<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    The portable document of a package: a copy of its document without what needs Windows (folder portable). A package whose document is written in the editor
    on Windows and uses Windows only packages or nodes sets PortableVlDocument (the file name of its document) and what to leave out:
      PortableVlDocumentRemoveDependencies  locations of dependency elements (VL.CoreLib.Windows, System.Windows.Forms, ./Other.vl, ...)
      PortableVlDocumentRemoveNodes         names (definitions) or ids (applications, pads, control points) of nodes; links to what is left out go with them
    The compiler takes it for a target other than Windows, and an editor without Windows Forms on every system (PackageInfo.PortableDocumentFolder,
    SessionConfiguration.PortablePackages). Made by every build of the net10.0 flavor (it sits in the folder of the package, where the compiler looks for it
    when a package is used from source) and packed.

    The task StripWindowsFromVlDocument does the work; a package with several such documents (VL.HDE) calls it itself. Besides the two lists above it takes:
      BypassNodes           ids of nodes which only pass a value on (a style in, the style with more out): they go, what came into their first input goes where
                            their outputs went
      RemoveItems           id:text, the item of that text from the value of a pad (an entry of a spread in an IOBox)
      RelocateDependencies  location=new location, as the dll of the other flavor, or a document of the package which has a portable copy (./X.vl=./portable/X.vl)
  -->
  <UsingTask TaskName="StripWindowsFromVlDocument" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Input ParameterType="System.String" Required="true" />
      <Output ParameterType="System.String" Required="true" />
      <RemoveDependencies ParameterType="System.String" />
      <RemoveNodes ParameterType="System.String" />
      <BypassNodes ParameterType="System.String" />
      <RemoveItems ParameterType="System.String" />
      <RelocateDependencies ParameterType="System.String" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Xml.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Func<string, string[]> List = s => (s ?? "").Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries);
        Func<XElement, string> Id = e => (string)e.Attribute("Id") ?? "";
        var doc = XDocument.Load(Input, LoadOptions.PreserveWhitespace);
        var dependencies = new HashSet<string>(List(RemoveDependencies));
        var relocations = List(RelocateDependencies).Select(r => r.Split('=')).ToDictionary(r => r[0], r => r[1]);
        var nodes = new HashSet<string>(List(RemoveNodes));
        foreach (var d in doc.Root.Elements().Where(e => e.Name.LocalName.EndsWith("Dependency")).ToList())
        {
            var location = (string)d.Attribute("Location") ?? "";
            string relocated;
            if (dependencies.Contains(location))
                d.Remove();
            else if (relocations.TryGetValue(location, out relocated))
                d.SetAttributeValue("Location", relocated);
        }
        var links = doc.Root.Descendants("Link").ToList();
        foreach (var id in List(BypassNodes))
        {
            var pins = doc.Root.Descendants("Node").Single(e => Id(e) == id).Elements("Pin").ToList();
            var input = Id(pins.First(p => (string)p.Attribute("Kind") == "InputPin" && (string)p.Attribute("IsHidden") != "true"));
            var outputs = new HashSet<string>(pins.Where(p => ((string)p.Attribute("Kind") ?? "").EndsWith("OutputPin")).Select(Id));
            var source = links.Select(l => ((string)l.Attribute("Ids")).Split(',')).Where(ids => ids[1] == input).Select(ids => ids[0]).SingleOrDefault();
            if (source != null)
                foreach (var l in links.Where(l => outputs.Contains(((string)l.Attribute("Ids")).Split(',')[0])))
                    l.SetAttributeValue("Ids", source + "," + ((string)l.Attribute("Ids")).Split(',')[1]);
            nodes.Add(id);
        }
        foreach (var item in List(RemoveItems))
        {
            var id = item.Substring(0, item.IndexOf(':'));
            var text = item.Substring(item.IndexOf(':') + 1);
            foreach (var e in doc.Root.Descendants().Where(e => Id(e) == id).Elements().Where(e => e.Name.LocalName == "Value").Elements("Item").Where(e => e.Value == text).ToList())
                e.Remove();
        }
        var elements = new[] { "Node", "Pad", "ControlPoint" };
        foreach (var n in doc.Root.Descendants().Where(e => (e.Name.LocalName == "Node" && nodes.Contains((string)e.Attribute("Name") ?? "")) || (elements.Contains(e.Name.LocalName) && nodes.Contains(Id(e)))).ToList())
            n.Remove();
        var ids = new HashSet<string>(doc.Root.Descendants().Select(Id).Where(i => i != ""));
        foreach (var l in doc.Root.Descendants("Link").Where(e => ((string)e.Attribute("Ids") ?? "").Split(',').Any(i => !ids.Contains(i))).ToList())
            l.Remove();
        System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(Output));
        doc.Save(Output);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="MakePortableVlDocument" AfterTargets="Build" Condition="'$(PortableVlDocument)' != '' AND '$(TargetFramework)' == 'net10.0'">
    <StripWindowsFromVlDocument Input="$(VLPackageBasePath)$(PortableVlDocument)" Output="$(VLPackageBasePath)portable\$(PortableVlDocument)"
                                RemoveDependencies="$(PortableVlDocumentRemoveDependencies)" RemoveNodes="$(PortableVlDocumentRemoveNodes)" />
  </Target>
  <Target Name="PackPortableVlDocument" BeforeTargets="_GetPackageFiles" DependsOnTargets="MakePortableVlDocument" Condition="'$(PortableVlDocument)' != ''">
    <ItemGroup>
      <Content Include="$(VLPackageBasePath)portable\$(PortableVlDocument)" PackagePath="portable\$(PortableVlDocument)" Pack="true" />
    </ItemGroup>
  </Target>
</Project>
