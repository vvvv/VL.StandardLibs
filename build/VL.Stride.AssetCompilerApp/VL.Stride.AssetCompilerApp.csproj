<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Don't pack this, it's build-time infrastructure -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Framework" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Tasks.Core" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" PrivateAssets="all" ExcludeAssets="runtime" />

    <PackageReference Include="Stride.AssetCompiler" GeneratePathProperty="true">
      <ExcludeAssets>build;buildTransitive</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyModel" />
    <PackageReference Include="Stride.Assets" />
    <!-- It's up to the project what runtime assembly to load (there are multiple) -->
    <PackageReference Include="Stride.Games" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(PkgStride_AssetCompiler)\tools\net10.0\Stride.NuGetResolver.dll">
      <Private>True</Private>
    </Reference>
  </ItemGroup>

</Project>
