<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- 
    VL Custom Stride Asset Compiler Targets

    This file provides a custom Stride asset compiler with VL-specific assembly resolution.

    Usage:
      Set VLStrideCompileAssets=true in projects that need asset compilation.
      Set VLStridePackageRepositories to semicolon-separated repository paths.

    Example in Directory.Build.props:
      <VLStridePackageRepositories>$(MSBuildThisFileDirectory)../../vvvv50;$(MSBuildThisFileDirectory)..</VLStridePackageRepositories>
  -->

  <PropertyGroup>
    <!-- Locate our custom asset compiler -->
    <VLStrideAssetCompilerProject>$(MSBuildThisFileDirectory)VL.Stride.AssetCompilerApp\VL.Stride.AssetCompilerApp.csproj</VLStrideAssetCompilerProject>
    <VLStrideAssetCompilerOutput>$(MSBuildThisFileDirectory)VL.Stride.AssetCompilerApp\bin\$(Configuration)\net10.0\VL.Stride.AssetCompilerApp.dll</VLStrideAssetCompilerOutput>

    <!-- Off Windows (see VL.Stride.Host.props) the app is built for the host's runtime identifier and with the graphics API
         of the project: Stride copies the Stride.Graphics.dll of the API when the app is built. One output and one
         intermediate folder per combination, so a change of the API builds again and nothing is mixed up. -->
    <VLStrideAssetCompilerKey Condition="'$(VLStrideHostRid)' != ''">$(VLStrideHostRid)-$(StrideGraphicsApi)</VLStrideAssetCompilerKey>
    <VLStrideAssetCompilerOutputDir Condition="'$(VLStrideHostRid)' != ''">$(MSBuildThisFileDirectory)VL.Stride.AssetCompilerApp\bin\$(Configuration)\$(VLStrideAssetCompilerKey)\</VLStrideAssetCompilerOutputDir>
    <VLStrideAssetCompilerOutput Condition="'$(VLStrideHostRid)' != ''">$(VLStrideAssetCompilerOutputDir)VL.Stride.AssetCompilerApp.dll</VLStrideAssetCompilerOutput>
    <VLStrideAssetCompilerProperties Condition="'$(VLStrideHostRid)' != ''">RuntimeIdentifier=$(VLStrideHostRid);SelfContained=false;AppendRuntimeIdentifierToOutputPath=false;StrideGraphicsApi=$(StrideGraphicsApi);OutputPath=$(VLStrideAssetCompilerOutputDir);BaseIntermediateOutputPath=$(MSBuildThisFileDirectory)VL.Stride.AssetCompilerApp\obj\$(VLStrideAssetCompilerKey)\</VLStrideAssetCompilerProperties>

    <VLStrideAssetCompilerWorkingDirectory Condition="'$(VLStrideAssetCompilerWorkingDirectory)' == ''">$(ProjectDir)</VLStrideAssetCompilerWorkingDirectory>

    <!-- Use PackageRepositories property from top-level Directory.Build.props -->
    <!-- Fallback to parent directory if not set (for standalone VL.StandardLibs repo) -->
    <VLStridePackageRepositories Condition="'$(VLStridePackageRepositories)' == '' AND '$(PackageRepositories)' != ''">$(PackageRepositories)</VLStridePackageRepositories>
    <VLStridePackageRepositories Condition="'$(VLStridePackageRepositories)' == ''">$(MSBuildThisFileDirectory)..</VLStridePackageRepositories>

    <!-- Asset build/output paths matching Stride conventions -->
    <VLStrideAssetBuildPath Condition="'$(VLStrideAssetBuildPath)' == ''">$(ProjectDir)$(BaseIntermediateOutputPath)stride\assetbuild\data</VLStrideAssetBuildPath>
    <VLStrideAssetOutputPath Condition="'$(VLStrideAssetOutputPath)' == ''">$(TargetDir)data</VLStrideAssetOutputPath>
    <VLStrideAssetUpToDateCheckFileBase>$(ProjectDir)$(IntermediateOutputPath)stride\assetcompiler-uptodatecheck</VLStrideAssetUpToDateCheckFileBase>
  </PropertyGroup>

  <!-- Build the custom asset compiler if needed -->
  <Target Name="_VLBuildStrideAssetCompiler" 
          BeforeTargets="VLCompileStrideAssets"
          Condition="'$(VLStrideCompileAssets)' == 'true' AND !Exists('$(VLStrideAssetCompilerOutput)')">
    <Message Importance="High" Text="[VL] Building custom Stride asset compiler..." />

    <!-- Restore in a separate evaluation (unique global property), otherwise Build reuses the evaluation from before
         the restore, which lacks the imports of nuget.g.props such as $(PkgStride_Assets) -->
    <MSBuild Projects="$(VLStrideAssetCompilerProject)"
             Targets="Restore"
             Properties="Configuration=$(Configuration);MSBuildRestoreSessionId=$([System.Guid]::NewGuid());$(VLStrideAssetCompilerProperties)" />
    <MSBuild Projects="$(VLStrideAssetCompilerProject)"
             Targets="Build"
             Properties="Configuration=$(Configuration);$(VLStrideAssetCompilerProperties)" />
  </Target>

  <!-- MSBuild has no property function to set an environment variable -->
  <UsingTask TaskName="VLSetEnvironmentVariable" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Name Required="true" />
      <Value Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[Environment.SetEnvironmentVariable(Name, Value);]]></Code>
    </Task>
  </UsingTask>
  <!-- Linux: what the asset compiler (and Stride's pack step, which runs it again) needs from the machine -->
  <Target Name="_VLPrepareStrideOnLinux"
          BeforeTargets="VLCompileStrideAssets;_StridePrepareAssetsForPack"
          DependsOnTargets="_VLBuildStrideAssetCompiler"
          Condition="'$(VLStrideCompileAssets)' == 'true' AND '$(VLStrideHostRid)' != ''">
    <!-- Stride asks for libassimp.so, the package ships libassimp.so.5 -->
    <ItemGroup>
      <_VLAssimp Include="$(VLStrideAssetCompilerOutputDir)libassimp.so.5;$(VLStrideAssetCompilerOutputDir)runtimes\$(VLStrideHostRid)\native\libassimp.so.5"
                 Condition="Exists('$(VLStrideAssetCompilerOutputDir)libassimp.so.5') OR Exists('$(VLStrideAssetCompilerOutputDir)runtimes\$(VLStrideHostRid)\native\libassimp.so.5')" />
    </ItemGroup>
    <Copy SourceFiles="@(_VLAssimp)" DestinationFiles="$(VLStrideAssetCompilerOutputDir)libassimp.so"
          Condition="Exists('%(_VLAssimp.FullPath)') AND !Exists('$(VLStrideAssetCompilerOutputDir)libassimp.so')" />

    <!-- Stride's pack step restores old runtime.* packages whose signature check fails when the package folder is empty.
         Set for this build only (the msbuild process and what it starts). -->
    <VLSetEnvironmentVariable Name="DOTNET_NUGET_SIGNATURE_VERIFICATION" Value="false" />

    <!-- Vulkan only: Stride starts its shader tool by the relative path linux-x64/glslangValidator.bin, which only exists in
         the content files of Stride.Shaders.Compiler. Put it under the output folder of the app and run the app there. -->
    <ItemGroup Condition="'$(StrideGraphicsApi)' == 'Vulkan'">
      <_VLGlslang Include="$([MSBuild]::EnsureTrailingSlash('$(NuGetPackageRoot)'))stride.shaders.compiler\*\contentFiles\any\any\$(VLStrideHostRid)\glslangValidator.bin" />
    </ItemGroup>
    <Copy Condition="'@(_VLGlslang)' != ''" SourceFiles="%(_VLGlslang.FullPath)" DestinationFolder="$(VLStrideAssetCompilerOutputDir)$(VLStrideHostRid)" SkipUnchangedFiles="true" />
    <PropertyGroup Condition="'$(StrideGraphicsApi)' == 'Vulkan'">
      <VLStrideAssetCompilerWorkingDirectory>$(VLStrideAssetCompilerOutputDir)</VLStrideAssetCompilerWorkingDirectory>
    </PropertyGroup>

    <Warning Condition="'$(StrideGraphicsApi)' == 'OpenGL' AND '$(DISPLAY)' == '' AND '$(WAYLAND_DISPLAY)' == ''"
             Text="[VL] The OpenGL asset compile needs a display. Without one, run the build under a virtual one: xvfb-run -a dotnet build ... (packages: xvfb libgl1-mesa-dri libglx-mesa0 libegl-mesa0), or set VLStrideLinuxGraphicsApi=Vulkan." />
  </Target>

  <!-- Collect up-to-date check inputs (matching Stride's behavior) -->
  <Target Name="_VLCollectUpToDateCheckInputDesignTime" 
          Condition="'$(VLStrideCompileAssets)' == 'true'">
    <ReadLinesFromFile File="$(VLStrideAssetUpToDateCheckFileBase).inputs" 
                       Condition="Exists('$(VLStrideAssetUpToDateCheckFileBase).inputs')">
      <Output TaskParameter="Lines" ItemName="VLStrideAssetInput"/>
    </ReadLinesFromFile>

    <ItemGroup>
      <!-- If no input (yet), make sure build doesn't skip by adding a fake input file -->
      <VLStrideAssetInput Condition="'@(VLStrideAssetInput)' == ''" Include="FakeInputForceBuild.file" />
    </ItemGroup>
  </Target>

  <!-- Collect up-to-date check outputs (matching Stride's behavior) -->
  <Target Name="_VLCollectUpToDateCheckOutputDesignTime" 
          Condition="'$(VLStrideCompileAssets)' == 'true'">
    <ReadLinesFromFile File="$(VLStrideAssetUpToDateCheckFileBase).outputs" 
                       Condition="Exists('$(VLStrideAssetUpToDateCheckFileBase).outputs')">
      <Output TaskParameter="Lines" ItemName="VLStrideAssetOutput"/>
    </ReadLinesFromFile>

    <ItemGroup>
      <!-- If no output (yet), make sure build doesn't skip by adding a fake output file -->
      <VLStrideAssetOutput Condition="'@(VLStrideAssetOutput)' == ''" Include="FakeBundleForceBuild.bundle" />
    </ItemGroup>
  </Target>

  <!-- Collect referenced project assemblies -->
  <Target Name="_VLCollectReferencedProjectAssemblies"
          Condition="'$(VLStrideCompileAssets)' == 'true'"
          DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <!-- Collect output assemblies from referenced projects -->
      <VLReferencedProjectAssembly Include="@(ReferencePath)" Condition="'%(ReferencePath.ReferenceSourceTarget)' == 'ProjectReference'" />
    </ItemGroup>
  </Target>

  <!-- Run the custom asset compiler -->
  <Target Name="VLCompileStrideAssets" 
          AfterTargets="Build"
          Condition="'$(VLStrideCompileAssets)' == 'true'"
          DependsOnTargets="_VLCollectUpToDateCheckInputDesignTime;_VLCollectUpToDateCheckOutputDesignTime;_VLCollectReferencedProjectAssemblies"
          Inputs="@(VLStrideAssetInput)" 
          Outputs="@(VLStrideAssetOutput)">

    <PropertyGroup>
      <!-- Build semicolon-separated list of assemblies (main assembly + referenced project assemblies) -->
      <VLStrideAssemblyList>$(TargetPath)</VLStrideAssemblyList>
      <VLStrideAssemblyList Condition="'@(VLReferencedProjectAssembly)' != ''">$(VLStrideAssemblyList);@(VLReferencedProjectAssembly)</VLStrideAssemblyList>

      <!-- Build the asset compiler command line (matching original Stride arguments) -->
      <VLStrideAssetCompilerArgs>--disable-auto-compile</VLStrideAssetCompilerArgs>
      <VLStrideAssetCompilerArgs>$(VLStrideAssetCompilerArgs) --project-configuration="$(Configuration)"</VLStrideAssetCompilerArgs>
      <VLStrideAssetCompilerArgs>$(VLStrideAssetCompilerArgs) --platform=$(StridePlatform)</VLStrideAssetCompilerArgs>
      <VLStrideAssetCompilerArgs Condition="'$(StrideGraphicsApi)' != ''">$(VLStrideAssetCompilerArgs) --compile-property:StrideGraphicsApi=$(StrideGraphicsApi)</VLStrideAssetCompilerArgs>
      <VLStrideAssetCompilerArgs>$(VLStrideAssetCompilerArgs) --output-path="$(VLStrideAssetOutputPath)"</VLStrideAssetCompilerArgs>
      <VLStrideAssetCompilerArgs>$(VLStrideAssetCompilerArgs) --build-path="$(VLStrideAssetBuildPath)"</VLStrideAssetCompilerArgs>
      <VLStrideAssetCompilerArgs>$(VLStrideAssetCompilerArgs) --package-file="$(MSBuildProjectFullPath)"</VLStrideAssetCompilerArgs>
      <VLStrideAssetCompilerArgs>$(VLStrideAssetCompilerArgs) --msbuild-uptodatecheck-filebase="$(VLStrideAssetUpToDateCheckFileBase)"</VLStrideAssetCompilerArgs>
      <VLStrideAssetCompilerArgs>$(VLStrideAssetCompilerArgs) --assembly-paths="$(VLStrideAssemblyList)"</VLStrideAssetCompilerArgs>
      <VLStrideAssetCompilerCommand>dotnet &quot;$(VLStrideAssetCompilerOutput)&quot; $(VLStrideAssetCompilerArgs)</VLStrideAssetCompilerCommand>
    </PropertyGroup>

    <!-- Ensure the output directory and intermediate directories exist -->
    <MakeDir Directories="$(TargetDir)" />
    <MakeDir Directories="$(ProjectDir)$(IntermediateOutputPath)stride" />

    <Message Importance="High" Text="[VL] $(VLStrideAssetCompilerCommand)" />

    <Exec Command="$(VLStrideAssetCompilerCommand)" 
          WorkingDirectory="$(VLStrideAssetCompilerWorkingDirectory)" />

    <!-- Create stamp file to track incremental builds -->
    <Touch Files="$(IntermediateOutputPath)VLStrideAssets.stamp" AlwaysCreate="true" />

    <!-- Ensure outputs are up-to-date -->
    <ItemGroup Condition="Exists('$(VLStrideAssetUpToDateCheckFileBase).outputs')">
      <VLStrideAssetOutput Remove="*" />
    </ItemGroup>

    <ReadLinesFromFile File="$(VLStrideAssetUpToDateCheckFileBase).outputs" 
                       Condition="Exists('$(VLStrideAssetUpToDateCheckFileBase).outputs')">
      <Output TaskParameter="Lines" ItemName="VLStrideAssetOutput"/>
    </ReadLinesFromFile>
  </Target>

  <Target Name="VLIncludeAssetDBInPackage"
          Condition="'$(VLStrideCompileAssets)' == 'true'" >

    <ReadLinesFromFile File="$(VLStrideAssetUpToDateCheckFileBase).outputs">
      <Output TaskParameter="Lines" ItemName="VLStrideBundles"/>
    </ReadLinesFromFile>

    <!-- Exclude default bundles since they come from VL.Stride.Runtime dependency -->
    <!-- Filter by checking if filename starts with "default" -->
    <ItemGroup>
      <VLStrideBundlesFiltered Include="@(VLStrideBundles)" 
                               Condition="'$(MSBuildProjectName)' == 'VL.Stride.Runtime' OR !$([System.IO.Path]::GetFileName('%(Identity)').StartsWith('default'))" />
    </ItemGroup>

    <Message Importance="high" Text="Adding @(VLStrideBundlesFiltered) to package" />

    <ItemGroup>
      <TfmSpecificPackageFile Include="@(VLStrideBundlesFiltered)" 
                              PackagePath="lib\$(TargetFramework)\data\db\bundles\%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

</Project>
