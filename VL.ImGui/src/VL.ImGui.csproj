<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputPath>..\lib</OutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>

    <VLPackageBasePath>..\</VLPackageBasePath>
	<Description>Base library for implementations of Dear ImGUi for vvvv</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only for the default font on Windows -->
    <PackageReference Include="System.Drawing.Common" PrivateAssets="compile" />
    <PackageReference Include="ImGui.NET" GeneratePathProperty="true">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>native;build;buildTransitive</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\VL.CoreLib\src\VL.CoreLib.csproj" />
    <ProjectReference Include="..\..\VL.Core\src\VL.Core.csproj" />
    <ProjectReference Include="..\..\VL.ImGui.Generator\VL.ImGui.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup Condition=" '$(DebugGenerator)'  == 'true' ">
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude the output of source generators from the compilation -->
    <Compile Remove="Generated\**\*.cs" />
    <None Include="Generated\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(VLPackageBasePath)runtimes\**\*">
      <LinkBase>runtimes</LinkBase>
      <Pack>true</Pack>
      <PackagePath>runtimes\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      <Visible>false</Visible>
    </None>

    <!-- The natives of Linux and macOS come from the ImGui.NET package. The ones for Windows are ours (runtimes folder above). -->
    <None Include="$(PkgImGui_NET)\runtimes\linux-x64\native\*">
      <Pack>true</Pack>
      <PackagePath>runtimes\linux-x64\native\%(Filename)%(Extension)</PackagePath>
      <Visible>false</Visible>
    </None>
    <None Include="$(PkgImGui_NET)\runtimes\osx\native\*">
      <Pack>true</Pack>
      <PackagePath>runtimes\osx\native\%(Filename)%(Extension)</PackagePath>
      <Visible>false</Visible>
    </None>

    <None Include="$(VLPackageBasePath)\vl.subs.json">
      <Pack>true</Pack>
      <PackagePath>%(Filename)%(Extension)</PackagePath>
    </None>

    <None Include="$(PkgImGui_NET)\lib\net6.0\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>lib\net10.0\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      <Visible>false</Visible>
    </None>
  </ItemGroup>
  
</Project>
